# Copy to .env.local. Both values are public (row level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: the public site address for share links (Vercel sets one automatically).
NEXT_PUBLIC_SITE_URL=
# Set to 1 once the custom sign-in email (supabase/templates/sign_in.html) is live. It needs a custom email sender.
NEXT_PUBLIC_EMAIL_HAS_CODE=
